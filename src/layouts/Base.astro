---
import '../styles/global.css';
const { title, description = "A personal collection of words and writing." } = Astro.props;
const path = Astro.url.pathname;
const isActive = (p) => path === p || (p !== '/' && path.startsWith(p));
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>📖</text></svg>" />
</head>
<body>
  <header class="site-header">
    <div class="header-inner">
      <a class="brand" href="/">prrath<span class="dot">.</span>notes</a>
      <nav class="nav">
        <a href="/words" aria-current={isActive('/words') ? 'page' : undefined}>Words</a>
        <a href="/blog" aria-current={isActive('/blog') ? 'page' : undefined}>Blog</a>
        <a class="nav-search" href="/search" aria-current={isActive('/search') ? 'page' : undefined}>Search</a>
        <a class="nav-admin" href="/admin.html" title="Admin" aria-label="Admin">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 20h9" />
            <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z" />
          </svg>
        </a>
      </nav>
    </div>
  </header>
  <main>
    <slot />
  </main>
  <footer>
    <div class="wrap">Written and kept by prrath · built with Astro · <a href="/search">search everything</a></div>
  </footer>
  <script is:inline>
    // "/" anywhere jumps to search
    document.addEventListener('keydown', (e) => {
      if (e.key === '/' && !/INPUT|TEXTAREA/.test(document.activeElement.tagName)) {
        const q = document.getElementById('q');
        if (q) { e.preventDefault(); q.focus(); }
        else { location.href = '/search'; }
      }
    });
  </script>
</body>
</html>
