---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const items = (await getCollection('concepts')).sort((a,b) => b.data.added - a.data.added);
---
<Base title="Concepts — prrath.notes">
  <div class="wrap">
    <div style="padding-top:2rem">
      <h1>Concepts</h1>
      <p style="color:var(--ink-2);margin:.3rem 0 0">Ideas explained the way they finally clicked for me.</p>
    </div>
    <div class="grid">
      {items.map(e => (
        <a class="card" href={`/concepts/${e.id}/`}>
          <span class="badge badge-concept">{e.data.field || 'concept'}</span>
          <h3>{e.data.title}</h3>
          <p>{e.data.summary}</p>
        </a>
      ))}
    </div>
  </div>
</Base>
