---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const [w, b] = await Promise.all([getCollection('words'), getCollection('blog')]);
const counts = {};
for (const e of [...w, ...b]) for (const t of e.data.tags) counts[t] = (counts[t] || 0) + 1;
const tags = Object.entries(counts).sort((a,b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---
<Base title="Tags — prrath.notes">
  <div class="wrap">
    <div><h1>Tags</h1>
    <p>Everything, cross-cut.</p></div>
    <div class="tags">
      {tags.map(([t, n]) => (
        <a class="tag" href={`/tags/${t}/`}>#{t} <span>{n}</span></a>
      ))}
    </div>
  </div>
</Base>
