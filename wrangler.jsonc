{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prraths-notes",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-04",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  // Secrets are managed in the Cloudflare dashboard. Without this, every
  // `wrangler deploy` would delete them and the writer would break.
  "keep_vars": true
}
